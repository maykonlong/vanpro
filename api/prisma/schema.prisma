generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// B2B SAAS CORE - TENANTS E PLANOS
// ----------------------------------------------------
model SubscriptionPlan {
  id          String    @id @default(uuid())
  name        String    // Ex: FREE, PRO, ENTERPRISE
  maxVehicles Int
  maxDrivers  Int
  price       Float
  
  companies   Company[]
}

model Company {
  id               String            @id @default(uuid())
  name             String
  document         String            @unique // CNPJ ou CPF
  subscriptionId   String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  plan             SubscriptionPlan  @relation(fields: [subscriptionId], references: [id])
  
  // Relacionamentos Inquebráveis (Multi-Tenancy)
  userContracts    UserCompany[]
  vehicles         Vehicle[]
  drivers          Driver[]
  students         Student[]
  timecards        Timecard[]
  financials       FinancialTransaction[]
}

// ----------------------------------------------------
// BUSINESS LOGIC
// ----------------------------------------------------
enum Role {
  SUPER_ADMIN // Mestre do SaaS
  OWNER       // Dono da Empresa (Frota)
  DRIVER      // Motorista
  ASSISTANT   // Auxiliar (Monitor)
  PARENT      // Pai do aluno
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contracts UserCompany[]
  auditLogs AuditLog[]
  notes     Note[]
}

model UserCompany {
  id           String   @id @default(uuid())
  userId       String
  companyId    String
  role         Role     @default(DRIVER)
  status       String   @default("INVITED") // INVITED, ACTIVE, SUSPENDED, ARCHIVED
  contractType String   @default("FULL_TIME") // FULL_TIME ou FREELANCE
  token        String?  @unique // Token do link de convite
  joinedAt     DateTime @default(now())
  leftAt       DateTime?

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

model Vehicle {
  id        String   @id @default(uuid())
  companyId String
  plate     String   @unique
  capacity  Int
  km        Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime? // Soft Delete (Fase 13)

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  timecards Timecard[]
}

model Driver {
  id        String   @id @default(uuid())
  companyId String
  name      String
  userId    String?  @unique
  role      Role     @default(DRIVER)
  shiftType String   
  dailyRate Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  timecards Timecard[]
}

model Student {
  id         String   @id @default(uuid())
  companyId  String
  name       String   /// @encrypted
  school     String
  shift      String
  monthlyFee Float    @default(0)
  status     String   @default("PENDING")
  parentId   String?
  photoUrl   String?  /// @encrypted
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime? // Soft Delete (Fase 13)

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financials FinancialTransaction[]
}

model Timecard {
  id        String   @id @default(uuid())
  companyId String
  driverId  String
  vehicleId String
  status    String   @default("IN_PROGRESS")
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  driver    Driver   @relation(fields: [driverId], references: [id])
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
}

model FinancialTransaction {
  id         String   @id @default(uuid())
  companyId  String
  studentId  String
  amount     Float
  paid       Boolean  @default(false)
  dueDate    DateTime
  externalId String?  @unique // ID do Asaas/Stripe
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  student    Student  @relation(fields: [studentId], references: [id])
}

// ----------------------------------------------------
// AUDIT & LOGS (Fase 13 - O Escudo Sentinela)
// ----------------------------------------------------
model AuditLog {
  id          String   @id @default(uuid())
  companyId   String?  // Pode ser nulo se a ação for do Super Admin global
  userId      String
  action      String   // CREATE_STUDENT, DELETE_VEHICLE, SQL_INJECTION_ATTEMPT
  description String
  ipAddress   String?
  createdAt   DateTime @default(now())

  company     Company? @relation(fields: [companyId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
}

// ----------------------------------------------------
// CRM & TEAM COLLABORATION (Fase 14)
// ----------------------------------------------------
model Note {
  id          String   @id @default(uuid())
  companyId   String
  studentId   String?  // Pode ser atrelado a um aluno (Ex: Criança chorou muito)
  authorId    String
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  author      User     @relation(fields: [authorId], references: [id])
}
