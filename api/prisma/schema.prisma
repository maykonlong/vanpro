// VanPro - schema multi-tenant.
// Regra: todo modelo de negocio carrega companyId e e filtrado pelo tenant-guard
// em src/lib/prisma.ts. Unicidade de negocio e SEMPRE composta com companyId,
// senao a colisao entre empresas vira vazamento de existencia.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ====================================================
// SAAS CORE
// ====================================================

model SubscriptionPlan {
  id            String  @id @default(uuid())
  name          String  @unique
  maxVehicles   Int
  maxDrivers    Int
  maxStudents   Int     @default(50)
  priceCents    Int    // centavos. Dinheiro em Float perde centavo em soma - BACEN 4658.
  gatewayPlanId String?

  companies Company[]
}

model SaaSSubscription {
  id               String    @id @default(uuid())
  companyId        String    @unique
  gateway          String    @default("ASAAS")
  gatewaySubId     String?
  status           String    @default("ACTIVE") // ACTIVE, PAST_DUE, CANCELED
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Company {
  id             String   @id @default(uuid())
  name           String
  document       String   @unique // CNPJ ou CPF, somente digitos
  subscriptionId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  latitude  Float?
  longitude Float?

  tenantStatus String    @default("TRIAL") // TRIAL, ACTIVE, PAST_DUE, SUSPENDED, CANCELED
  trialEndsAt  DateTime?
  suspendedAt  DateTime?

  plan             SubscriptionPlan  @relation(fields: [subscriptionId], references: [id])
  saasSubscription SaaSSubscription?

  userContracts UserCompany[]
  vehicles      Vehicle[]
  drivers       Driver[]
  students      Student[]
  timecards     Timecard[]
  punches       Punch[]
  financials    FinancialTransaction[]
  invoices      Invoice[]
  expenses      Expense[]
  charters      Charter[]
  aiCampaigns   AICampaign[]
  aiPosts       AIPost[]
  auditLogs     AuditLog[]
  notes         Note[]
  incidents     IncidentAlert[]
  teamMessages  TeamMessage[]
  sessions      Session[]

  @@index([tenantStatus])
  @@index([trialEndsAt])
}

// ====================================================
// IDENTIDADE E SESSAO
// ====================================================

enum Role {
  SUPER_ADMIN
  OWNER
  MANAGER
  DRIVER
  ASSISTANT
  PARENT
}

model User {
  id                String   @id @default(uuid())
  name              String
  email             String   @unique
  password          String
  passwordUpdatedAt DateTime @default(now())

  isTwoFactorEnabled     Boolean @default(false)
  twoFactorSecret        String? /// @encrypted
  pendingTwoFactorSecret String? /// @encrypted
  twoFactorRecoveryCodes String? /// @encrypted
  currentChallenge       String?

  // Bloqueio progressivo por tentativa de login
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  /// Papel de PLATAFORMA. Para o que a pessoa pode fazer DENTRO de uma frota,
  /// a fonte e `UserCompany.role` da empresa ativa da sessao — alguem pode ser
  /// dono de uma frota e motorista em outra.
  role      Role     @default(DRIVER)
  /// Ultima empresa usada, apenas como sugestao no proximo login.
  /// NAO e usada para autorizacao: quem decide e a sessao.
  tenantId  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contracts      UserCompany[]
  auditLogs      AuditLog[]
  notes          Note[]
  expenses       Expense[]
  authenticators Authenticator[]
  resetTokens    PasswordResetToken[]
  sessions       Session[]
  students       Student[]            @relation("ParentToStudent")
  /// Plural de proposito: a mesma pessoa tem um cadastro de motorista POR
  /// frota, com diaria propria em cada uma.
  driverProfiles Driver[]

  @@index([tenantId])
}

/// Sessao de refresh. Token guardado como hash: vazamento de banco nao vira
/// sessao valida. Rotacao com deteccao de reuso (familia revogada inteira).
model Session {
  id            String    @id @default(uuid())
  userId        String
  /// Empresa ATIVA desta sessao.
  ///
  /// A empresa e propriedade da sessao, e nao do usuario. Sem isso, o motorista
  /// freelancer — que o produto promete e o seed exercita — fica preso na
  /// primeira frota: `User.tenantId` e um escalar, e o segundo vinculo em
  /// `UserCompany` vira linha morta no banco.
  ///
  /// Nulo apenas para SUPER_ADMIN, que opera a plataforma e nao uma frota.
  companyId     String?
  familyId      String
  tokenHash     String    @unique
  userAgentHash String
  ipAddress     String?
  expiresAt     DateTime
  revokedAt     DateTime?
  replacedById  String?
  createdAt     DateTime  @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model Authenticator {
  id                   String  @id @default(uuid())
  credentialID         Bytes   @unique
  credentialPublicKey  Bytes
  counter              BigInt
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String  @default("")

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserCompany {
  id           String @id @default(uuid())
  userId       String
  companyId    String
  role         Role   @default(DRIVER)
  status       String @default("INVITED") // INVITED, ACTIVE, SUSPENDED, ARCHIVED
  contractType String @default("FULL_TIME") // FULL_TIME, FREELANCE

  canManageFinance Boolean @default(false)
  canManageHR      Boolean @default(false)
  canManageRoutes  Boolean @default(false)

  inviteTokenHash String?   @unique
  inviteExpiresAt DateTime?
  joinedAt        DateTime  @default(now())
  leftAt          DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId, status])
}

// ====================================================
// FROTA
// ====================================================

model Vehicle {
  id        String    @id @default(uuid())
  companyId String
  plate     String
  model     String    @default("")
  capacity  Int
  km        Int       @default(0)
  status    String    @default("IDLE") // IDLE, ON_ROUTE, MAINTENANCE
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  timecards Timecard[]
  expenses  Expense[]
  charters  Charter[]

  @@unique([companyId, plate])
  @@index([companyId, deletedAt])
}

model Driver {
  id        String   @id @default(uuid())
  companyId String
  name      String
  /// A MESMA pessoa pode ser motorista em mais de uma frota, com diaria
  /// diferente em cada uma — e isso que define o freelancer. Por isso a
  /// unicidade e por empresa (@@unique abaixo), e nao global.
  userId    String?
  shiftType String   @default("MORNING") // MORNING, AFTERNOON, FULL
  dailyRateCents Int   @default(0) // centavos
  status    String   @default("ACTIVE") // ACTIVE, ARCHIVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id])
  timecards Timecard[]
  charters  Charter[]

  @@unique([companyId, userId])
  @@index([companyId, status])
  @@index([userId])
}

model Student {
  id         String @id @default(uuid())
  companyId  String
  name       String /// @encrypted
  school     String
  grade      String @default("")
  shift      String // MORNING, AFTERNOON, FULL
  monthlyFeeCents Int  @default(0) // centavos
  status     String @default("PENDING") // PENDING, BOARDED, DELIVERED, ABSENT

  parentId String?
  parent   User?   @relation("ParentToStudent", fields: [parentId], references: [id])

  photoUrl String? /// @encrypted

  lgpdConsent  Boolean   @default(false)
  imageConsent Boolean   @default(false)
  consentDate  DateTime?
  dateOfBirth  DateTime?

  address   String? /// @encrypted
  latitude  Float?
  longitude Float?

  deleteRequestStatus String? @default("NONE") // NONE, PENDING_APPROVAL, DELETED

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company    Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financials FinancialTransaction[]
  invoices   Invoice[]
  notes      Note[]

  @@index([companyId, deletedAt])
  @@index([companyId, shift])
  @@index([parentId])
}

model Timecard {
  id        String   @id @default(uuid())
  companyId String
  driverId  String
  vehicleId String
  status    String   @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  driver  Driver  @relation(fields: [driverId], references: [id])
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  punches Punch[]

  @@index([companyId, status])
  @@index([driverId, status])
}

model Punch {
  id         String   @id @default(uuid())
  companyId  String
  timecardId String
  type       String // CLOCK_IN, BREAK_START, BREAK_END, CLOCK_OUT
  km         Int?
  latitude   Float?
  longitude  Float?
  createdAt  DateTime @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  timecard Timecard @relation(fields: [timecardId], references: [id], onDelete: Cascade)

  @@index([timecardId])
  @@index([companyId, createdAt])
}

// ====================================================
// FINANCEIRO
// ====================================================

model FinancialTransaction {
  id         String    @id @default(uuid())
  companyId  String
  studentId  String
  amountCents Int
  paid       Boolean   @default(false)
  paidAt     DateTime?
  dueDate    DateTime
  externalId String?   @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id])

  @@index([companyId, paid, dueDate])
  @@index([studentId])
}

model Invoice {
  id         String   @id @default(uuid())
  companyId  String
  studentId  String
  gatewayId  String?  @unique
  amountCents Int
  status     String   @default("PENDING") // PENDING, RECEIVED, OVERDUE, CANCELED
  dueDate    DateTime
  paymentUrl String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([companyId, status, dueDate])
}

model Expense {
  id          String   @id @default(uuid())
  companyId   String
  description String
  amountCents Int
  category    String // FUEL, MAINTENANCE, PAYROLL, TAXES, OTHER
  date        DateTime @default(now())
  vehicleId   String?
  employeeId  String?
  receiptUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle  Vehicle? @relation(fields: [vehicleId], references: [id])
  employee User?    @relation(fields: [employeeId], references: [id])

  @@index([companyId, date])
  @@index([companyId, category])
}

// ====================================================
// AUDITORIA (append-only, encadeada por hash)
// ====================================================

model AuditLog {
  id          String   @id @default(uuid())
  companyId   String?
  userId      String?
  action      String
  description String
  ipAddress   String?
  userAgent   String?
  /// Hash do registro anterior da mesma empresa. Reescrever historico quebra a cadeia.
  prevHash    String?
  hash        String
  createdAt   DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])

  @@index([companyId, createdAt])
  @@index([action])
}

// ====================================================
// CRM / COMUNICACAO
// ====================================================

model Note {
  id        String   @id @default(uuid())
  companyId String
  studentId String
  authorId  String
  content   String /// @encrypted
  isSecret  Boolean  @default(true)
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@index([companyId, studentId])
}

model IncidentAlert {
  id          String   @id @default(uuid())
  companyId   String
  title       String
  description String
  severity    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  createdById String?
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
}

model TeamMessage {
  id         String   @id @default(uuid())
  companyId  String
  senderId   String
  senderName String
  content    String /// @encrypted
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
}

// ====================================================
// FRETAMENTO
// ====================================================

model Charter {
  id         String   @id @default(uuid())
  companyId  String
  title      String
  contractor String
  priceCents Int
  startDate  DateTime
  endDate    DateTime
  status     String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, CANCELED
  vehicleId  String?
  driverId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])
  driver  Driver?  @relation(fields: [driverId], references: [id])

  @@index([companyId, status])
  @@index([companyId, startDate])
}

// ====================================================
// CRM COM IA
// ====================================================

model AICampaign {
  id        String   @id @default(uuid())
  companyId String
  name      String
  template  String
  target    String // ALL_STUDENTS, ALL_PARENTS, SPECIFIC
  channel   String // WHATSAPP, INSTAGRAM, EMAIL
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  posts   AIPost[]

  @@index([companyId, isActive])
}

model AIPost {
  id          String    @id @default(uuid())
  companyId   String
  campaignId  String?
  content     String
  imageUrl    String?
  targetId    String?
  channel     String
  status      String    @default("DRAFT") // DRAFT, APPROVED, PUBLISHED, REJECTED
  scheduledTo DateTime?
  createdAt   DateTime  @default(now())

  company  Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaign AICampaign? @relation(fields: [campaignId], references: [id])

  @@index([companyId, status])
}

// ====================================================
// INTEGRACOES
// ====================================================

/// Idempotencia de webhook: gateway reenvia o mesmo evento, e reprocessar
/// pagamento duas vezes e erro contabil.
model WebhookEvent {
  id          String   @id @default(uuid())
  provider    String // ASAAS, STRIPE
  externalId  String
  eventType   String
  payloadHash String
  processedAt DateTime @default(now())

  @@unique([provider, externalId])
  @@index([processedAt])
}
