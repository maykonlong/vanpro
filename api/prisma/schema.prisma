generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// B2B SAAS CORE - TENANTS E PLANOS
// ----------------------------------------------------
model SubscriptionPlan {
  id          String    @id @default(uuid())
  name        String    // Ex: FREE, PRO, ENTERPRISE
  maxVehicles Int
  maxDrivers  Int
  price       Float
  stripePriceId String? // ID do plano no Gateway (Stripe/MercadoPago)
  
  companies   Company[]
}

model SaaSSubscription {
  id              String   @id @default(uuid())
  companyId       String   @unique
  gateway         String   @default("STRIPE") // STRIPE, ASAAS, MERCADOPAGO
  gatewaySubId    String?  // ID da assinatura no gateway
  status          String   @default("ACTIVE") // ACTIVE, PAST_DUE, CANCELED
  currentPeriodEnd DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Company {
  id               String            @id @default(uuid())
  name             String
  document         String            @unique // CNPJ ou CPF
  subscriptionId   String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Coordenadas da Garagem/Base (Fase 22)
  latitude         Float?
  longitude        Float?

  plan             SubscriptionPlan  @relation(fields: [subscriptionId], references: [id])
  saasSubscription SaaSSubscription?
  
  // Relacionamentos Inquebráveis (Multi-Tenancy)
  userContracts    UserCompany[]
  vehicles         Vehicle[]
  drivers          Driver[]
  students         Student[]
  timecards        Timecard[]
  financials       FinancialTransaction[]
  expenses         Expense[]
  charters         Charter[]
  aiCampaigns      AICampaign[]
  aiPosts          AIPost[]

  // Colaboração da Frota (Fase 30)
  incidentAlerts   IncidentAlert[]
  teamMessages     TeamMessage[]
}

// ----------------------------------------------------
// BUSINESS LOGIC
// ----------------------------------------------------
enum Role {
  SUPER_ADMIN // Mestre do SaaS
  OWNER       // Dono da Empresa (Frota)
  MANAGER     // Gestor Administrativo
  DRIVER      // Motorista
  ASSISTANT   // Auxiliar (Monitor)
  PARENT      // Pai do aluno
}

model User {
  id                String   @id @default(uuid())
  name              String
  email             String   @unique
  password          String
  passwordUpdatedAt DateTime @default(now()) // Para forçar troca a cada 90 dias

  // 2FA e WebAuthn
  isTwoFactorEnabled Boolean @default(false)
  twoFactorSecret    String?
  currentChallenge   String? // Usado no WebAuthn (Passkeys)

  role              Role     @default(DRIVER)
  tenantId          String?  // Pode ser nulo se Super Admin
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  contracts         UserCompany[]
  auditLogs         AuditLog[]
  notes             Note[]
  expenses          Expense[]
  authenticators    Authenticator[]
  resetTokens       PasswordResetToken[]
  students          Student[]       @relation("ParentToStudent")
}

// ----------------------------------------------------
// WEBAUTHN (PASSKEYS / BIOMETRIA)
// ----------------------------------------------------
model Authenticator {
  id                   String  @id @default(uuid())
  credentialID         Bytes   @unique
  credentialPublicKey  Bytes
  counter              BigInt
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String
  
  userId               String
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model UserCompany {
  id           String   @id @default(uuid())
  userId       String
  companyId    String
  role         Role     @default(DRIVER)
  status       String   @default("INVITED") // INVITED, ACTIVE, SUSPENDED, ARCHIVED
  contractType String   @default("FULL_TIME") // FULL_TIME ou FREELANCE
  
  // Feature Flags (Permissões Granulares)
  canManageFinance Boolean @default(false)
  canManageHR      Boolean @default(false)
  canManageRoutes  Boolean @default(false)
  
  token        String?  @unique // Token do link de convite
  joinedAt     DateTime @default(now())
  leftAt       DateTime?

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

model Vehicle {
  id        String   @id @default(uuid())
  companyId String
  plate     String   @unique
  capacity  Int
  km        Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime? // Soft Delete (Fase 13)

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  timecards Timecard[]
  expenses  Expense[] // Despesas atreladas a este veículo
  charters  Charter[] // Viagens esporádicas agendadas para esta van
}

model Driver {
  id        String   @id @default(uuid())
  companyId String
  name      String
  userId    String?  @unique
  role      Role     @default(DRIVER)
  shiftType String   
  dailyRate Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  timecards Timecard[]
  charters  Charter[] // Fretamentos atribuídos a este motorista
}

model Student {
  id         String   @id @default(uuid())
  companyId  String
  name       String   /// @encrypted
  school     String
  shift      String
  monthlyFee Float    @default(0)
  status     String   @default("PENDING")
  parentId   String?
  parent     User?    @relation("ParentToStudent", fields: [parentId], references: [id])
  photoUrl   String?  /// @encrypted
  
  // Conformidade LGPD & ECA
  lgpdConsent   Boolean @default(false)
  imageConsent  Boolean @default(false) // Autorização de imagem para redes sociais
  consentDate   DateTime?
  dateOfBirth   DateTime? // Para mensagens de Aniversário
  
  // Localização e Trajetos (Google Maps API / TSP)
  address     String?
  latitude    Float?
  longitude   Float?

  deleteRequestStatus String? @default("NONE") // NONE, PENDING_APPROVAL, DELETED

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime? // Soft Delete (Fase 13)

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financials FinancialTransaction[]
  invoices   Invoice[] // Faturas emitidas para os pais (Asaas)
}

model Timecard {
  id        String   @id @default(uuid())
  companyId String
  driverId  String
  vehicleId String
  status    String   @default("IN_PROGRESS")
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  driver    Driver   @relation(fields: [driverId], references: [id])
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
}

model FinancialTransaction {
  id         String   @id @default(uuid())
  companyId  String
  studentId  String
  amount     Float
  paid       Boolean  @default(false)
  dueDate    DateTime
  externalId String?  @unique // ID do Asaas/Stripe
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  student    Student  @relation(fields: [studentId], references: [id])
}

// ----------------------------------------------------
// FATURAMENTO E COBRANÇAS PARA OS PAIS (Asaas API)
// ----------------------------------------------------
model Invoice {
  id         String   @id @default(uuid())
  companyId  String
  studentId  String
  gatewayId  String?  // ID do Boleto/Pix no Asaas
  amount     Float
  status     String   @default("PENDING") // PENDING, RECEIVED, OVERDUE
  dueDate    DateTime
  paymentUrl String?  // Link do Boleto ou QrCode PIX
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// Fase 19: Saídas (Despesas e DRE)
model Expense {
  id          String   @id @default(uuid())
  companyId   String
  description String
  amount      Float
  category    String   // FUEL, MAINTENANCE, PAYROLL, TAXES, OTHER
  date        DateTime @default(now())
  vehicleId   String?  // Gasto atrelado a veículo (Manutenção/Combustível)
  employeeId  String?  // Gasto atrelado a funcionário (Pagamento/Diária)
  receiptUrl  String?  // Link do cupom fiscal/comprovante
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle     Vehicle? @relation(fields: [vehicleId], references: [id])
  employee    User?    @relation(fields: [employeeId], references: [id])
}

// ----------------------------------------------------
// AUDIT & LOGS (Fase 13 - O Escudo Sentinela)
// ----------------------------------------------------
model AuditLog {
  id          String   @id @default(uuid())
  companyId   String?  // Pode ser nulo se a ação for do Super Admin global
  userId      String
  action      String   // CREATE_STUDENT, DELETE_VEHICLE, SQL_INJECTION_ATTEMPT
  description String
  ipAddress   String?
  createdAt   DateTime @default(now())

  company     Company? @relation(fields: [companyId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
}

// ----------------------------------------------------
// CRM & TEAM COLLABORATION (Fase 14)
// ----------------------------------------------------
model Note {
  id          String   @id @default(uuid())
  companyId   String
  studentId   String?  // Pode ser atrelado a um aluno (Ex: Criança chorou muito)
  authorId    String
  content     String
  isSecret    Boolean  @default(true) // Verdadeiro = Só equipe vê, Pais não veem.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  author      User     @relation(fields: [authorId], references: [id])
}

// ----------------------------------------------------
// INCIDENTES & COMUNICAÇÃO DE MASSA (Fase 30)
// ----------------------------------------------------
model IncidentAlert {
  id          String   @id @default(uuid())
  title       String
  description String
  severity    String   @default("MEDIUM") // LOW, MEDIUM, HIGH

  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}

model TeamMessage {
  id          String   @id @default(uuid())
  content     String
  
  senderId    String
  senderName  String
  
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}

// ----------------------------------------------------
// EVENTOS & FRETAMENTOS (Fase 21 - Viagens Esporádicas)
// ----------------------------------------------------
model Charter {
  id            String   @id @default(uuid())
  companyId     String
  title         String   // Ex: "Excursão Praia" ou "Evento Corporativo"
  contractor    String   // Nome de quem contratou
  price         Float    // Valor cobrado pelo frete
  
  // Controle de Tempo
  startDate     DateTime // Data e hora de início
  endDate       DateTime // Data e hora de término (pode ser o mesmo dia ou dias depois)
  
  status        String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, CANCELED

  // Atribuição (Quem vai e com qual Van)
  vehicleId     String?
  driverId      String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle       Vehicle? @relation(fields: [vehicleId], references: [id])
  driver        Driver?  @relation(fields: [driverId], references: [id])
}

// ----------------------------------------------------
// FASE 23: CRM E MARKETING COM INTELIGÊNCIA ARTIFICIAL
// ----------------------------------------------------
model AICampaign {
  id          String   @id @default(uuid())
  companyId   String
  name        String   // Ex: "Campanha de Férias", "Feliz Aniversário Automático"
  template    String   // O prompt/contexto base para a IA
  target      String   // ALL_STUDENTS, ALL_PARENTS, SPECIFIC
  channel     String   // WHATSAPP, INSTAGRAM, EMAIL
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  posts       AIPost[]
}

model AIPost {
  id          String   @id @default(uuid())
  companyId   String
  campaignId  String?
  content     String   // O texto gerado pela LLM
  imageUrl    String?  // Imagem anexada (ex: Card de aniversário)
  targetId    String?  // Id do Pai ou Aluno que vai receber (se for privado)
  channel     String   // WHATSAPP_STATUS, WHATSAPP_PRIVATE, INSTAGRAM
  status      String   @default("DRAFT") // DRAFT (Esperando aprovação), APPROVED, PUBLISHED
  scheduledTo DateTime?
  createdAt   DateTime @default(now())

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaign    AICampaign? @relation(fields: [campaignId], references: [id])
}
