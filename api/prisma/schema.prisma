generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// B2B SAAS CORE - TENANTS E PLANOS
// ----------------------------------------------------
model SubscriptionPlan {
  id          String    @id @default(uuid())
  name        String    // Ex: FREE, PRO, ENTERPRISE
  maxVehicles Int
  maxDrivers  Int
  price       Float
  
  companies   Company[]
}

model Company {
  id               String            @id @default(uuid())
  name             String
  document         String            @unique // CNPJ ou CPF
  subscriptionId   String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  plan             SubscriptionPlan  @relation(fields: [subscriptionId], references: [id])
  
  // Relacionamentos Inquebráveis (Multi-Tenancy)
  users            User[]
  vehicles         Vehicle[]
  drivers          Driver[]
  students         Student[]
  timecards        Timecard[]
  financials       FinancialTransaction[]
}

// ----------------------------------------------------
// BUSINESS LOGIC
// ----------------------------------------------------
enum Role {
  SUPER_ADMIN // Mestre do SaaS
  OWNER       // Dono da Empresa (Frota)
  DRIVER      // Motorista
  ASSISTANT   // Auxiliar (Monitor)
  PARENT      // Pai do aluno
}

model User {
  id        String   @id @default(uuid())
  companyId String?  // Super_Admin não tem company
  name      String
  email     String   @unique
  password  String
  role      Role     @default(PARENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Vehicle {
  id        String   @id @default(uuid())
  companyId String
  plate     String   @unique
  capacity  Int
  km        Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  timecards Timecard[]
}

model Driver {
  id        String   @id @default(uuid())
  companyId String
  name      String
  userId    String?  @unique
  role      Role     @default(DRIVER)
  shiftType String   
  dailyRate Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  timecards Timecard[]
}

model Student {
  id         String   @id @default(uuid())
  companyId  String
  name       String
  school     String
  shift      String
  monthlyFee Float    @default(0)
  status     String   @default("PENDING")
  parentId   String?
  photoUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financials FinancialTransaction[]
}

model Timecard {
  id        String   @id @default(uuid())
  companyId String
  driverId  String
  vehicleId String
  status    String   @default("IN_PROGRESS")
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  driver    Driver   @relation(fields: [driverId], references: [id])
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
}

model FinancialTransaction {
  id         String   @id @default(uuid())
  companyId  String
  studentId  String
  amount     Float
  paid       Boolean  @default(false)
  dueDate    DateTime
  externalId String?  @unique // ID do Asaas/Stripe
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  student    Student  @relation(fields: [studentId], references: [id])
}
