# ---------------------------------------------------------------------------
# VanPro API — variaveis de ambiente
#
# Copie para `.env` e preencha. NENHUM segredo tem valor padrao: se faltar, a
# API nao sobe. Isso e proposital — a versao anterior tinha
# `JWT_SECRET || 'super_secret_jwt_vanpro_key_123'`, o que significa que
# qualquer deploy sem a variavel rodava com um segredo publico no GitHub.
#
# Gere os segredos de uma vez:  node ../infra/scripts/gen-secrets.mjs --write
# Gere os certificados:         bash ../infra/scripts/gerar-certificados.sh
#
# ─── A lista e curta de proposito ─────────────────────────────────────────
#
# Toda variavel abaixo foi conferida contra o uso real no codigo. `SENTRY_DSN`
# e `GOOGLE_MAPS_KEY` sairam nesta revisao: as duas eram lidas, viravam uma
# flag booleana e ninguem consumia a flag. Variavel de ambiente que nao liga
# nada e pior que inutil — ela sugere que existe uma integracao configurada, e
# o operador passa a tratar como configurado o que nao existe.
# ---------------------------------------------------------------------------

# NODE_ENV controla otimizacao de build. APP_ENV controla o RIGOR das travas.
NODE_ENV=development
APP_ENV=local            # local | staging | production
PORT=3000
LOG_LEVEL=info           # nivel do pino; `debug` vaza volume, nao PII

# --- Banco (PostgreSQL obrigatorio; SQLite e recusado no boot) --------------
#
# Em APP_ENV=production a URL PRECISA de:
#   sslmode=require      cifra o fio
#   sslaccept=strict     verifica o certificado do servidor (o padrao do Prisma
#                        e `accept_invalid_certs`: aceita qualquer um)
#   sslcert=<ca>         a ancora de confianca, gerada por gerar-certificados.sh
#
# A API usa `vanpro_app`, que so tem SELECT/INSERT/UPDATE/DELETE. Migrations
# rodam com `vanpro_owner`, no servico `migrate`.
DATABASE_URL=postgresql://vanpro_app:senha@localhost:5433/vanpro?schema=public&sslmode=require&sslcert=../../infra/certs/db/ca.crt&sslaccept=strict

# --- Redis (rate limit distribuido) ----------------------------------------
# Sem Redis a API sobe, mas o rate limit conta por processo: com N replicas o
# limite fica N vezes mais frouxo.
REDIS_URL=redis://localhost:6380

# --- Sessao ----------------------------------------------------------------
# Minimo 32 caracteres cada, e precisam ser DIFERENTES entre si.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m            # vida do access token
REFRESH_TOKEN_TTL_DAYS=7        # vida do refresh token, em dias

# --- Criptografia em repouso (nome, endereco e foto do aluno) --------------
# Formato k1.aesgcm256.<32 bytes base64url>
#   npx prisma-field-encryption generate-key
# ATENCAO: perder esta chave torna os dados cifrados ilegiveis para sempre.
# Guarde em cofre (AWS Secrets Manager / Vault), nunca no repositorio.
# Detalhes e rotacao: docs/CRIPTOGRAFIA.md
PRISMA_FIELD_ENCRYPTION_KEY=
# Chaves ANTIGAS, aceitas so na leitura, enquanto uma rotacao esta em andamento.
# Lista separada por virgula. Vazio no dia a dia — e o unico jeito de rotacionar
# a chave sem tornar ilegivel, na hora, tudo o que ja estava cifrado.
# PRISMA_FIELD_DECRYPTION_KEYS=

# --- Front / cookies -------------------------------------------------------
# Origem unica aceita pelo CORS. Em producao TEM de ser https.
FRONTEND_URL=http://localhost:5173
# Origens extras, separadas por virgula. Existe para o caso de proxy reverso
# que apresenta um nome diferente do configurado acima. Deixe vazio se nao for
# o caso — cada origem aqui e uma origem a mais que pode chamar a API.
CORS_EXTRA_ORIGINS=
# COOKIE_DOMAIN=.vanpro.com.br     # so em producao com subdominios

# --- WebAuthn / Passkeys ---------------------------------------------------
# RP_ID e o dominio (sem esquema nem porta) e nao pode ser `localhost` em
# producao. ORIGIN e a URL completa, https em producao.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=VanPro
WEBAUTHN_ORIGIN=http://localhost:5173

# --- Uploads ---------------------------------------------------------------
UPLOAD_MAX_BYTES=5242880         # 5 MiB; o nginx corta em 6 MiB antes disto

# --- Rotinas agendadas -----------------------------------------------------
# Deixe `false` em maquina de desenvolvedor; ligue em UMA instancia de producao.
ENABLE_CRON=false

# ---------------------------------------------------------------------------
# INTEGRACOES — todas opcionais.
# Ausencia DESLIGA a funcionalidade (a API responde 503 FEATURE_DISABLED).
# Nenhuma delas e simulada: a versao anterior gravava cobranca falsa no banco
# quando a chave faltava, e o painel mostrava faturamento que nao existia.
# ---------------------------------------------------------------------------

# Cobranca Pix/boleto
# ASAAS_API_KEY=
# ASAAS_API_URL=https://sandbox.asaas.com/api/v3
# ASAAS_WEBHOOK_TOKEN=              # obrigatorio se ASAAS_API_KEY estiver setada

# WhatsApp Business
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
